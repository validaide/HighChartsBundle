{
  "name"        : "validaide/highchartsbundle",
  "license"     : "MIT",
  "type"        : "symfony-bundle",
  "description" : "HighCharts integration for your Symfony 5 project.",
  "keywords"    : [
    "highcharts",
    "symfony",
    "bundle"
  ],
  "authors"     : [
    {
      "name" : "Marcel Tuinstra",
      "email": "marcel.tuinstra@validaide.com"
    },
    {
      "name" : "Mark Bijl",
      "email": "mark.bijl@validaide.com"
    },
    {
      "name" : "Yakup Arslan",
      "email": "yakup.arslan@validaide.com"
    }
  ],
  "config"      : {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true
    }
  },
  "require"     : {
    "php": "^8.4",
    "ext-json": "*",
    "symfony/console": "*",
    "symfony/dependency-injection": "*",
    "symfony/flex": "^2.5",
    "symfony/framework-bundle": "*",
    "symfony/options-resolver": "*",
    "symfony/process": "*",
    "symfony/property-access": "*",
    "symfony/twig-bundle": "*",
    "symfony/yaml": "*",
    "twig/twig": "^3.0.4"
  },
  "require-dev" : {
    "brianium/paratest"     : "^6.0",
    "phpstan/phpstan"       : "^1.10",
    "phpunit/phpunit"       : "^9.5",
    "rector/rector"         : "^0.15.2",
    "symfony/phpunit-bridge": "*"
  },
  "autoload"    : {
    "psr-4": {
      "Validaide\\HighChartsBundle\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Validaide\\HighChartsBundle\\": "Tests/"
    }
  },
  "scripts"     : {
    "auto-scripts": {
      "cache:clear"                : "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "extra"       : {
    "symfony": {
      "require": "6.4.*"
    }
  }
}
